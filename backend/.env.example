# Copy to .env and fill in.

# Supabase Project Settings -> Database -> Connection string -> "Transaction
# pooler" (port 6543), password filled in. See supabase/README.md.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:6543/postgres

OPENAI_API_KEY=sk-...

# Defaults to gpt-4o (better at reading Thai than gpt-4o-mini). Override if needed.
# OPENAI_MODEL=gpt-4o

# Comma-separated list of origins allowed to call this API (your Next.js dev/prod URLs).
CORS_ORIGINS=http://localhost:3000
